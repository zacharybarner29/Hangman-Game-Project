#Functions
def hint(word, hidden_words):
  return word[:2:] + hidden_words[2::] #List slicing

def win_or_lose(word, guesses_left, W):
  score = (guesses_left/6) * 100//1 #Final score (percentage)
  if W == True:
    print(f'\nCongratulations! You guessed the correct word with {guesses_left} guesses left and scored {score}%')
  else:
    print(f'\nYou ran out of guesses. the correct word was "{''.join(word)}". Play again!')

def letter_checker(word, letter_guess, correct_letters):
  for i in range(len(word)):
    if letter_guess == word[i]: #checks each value in the list if it is the letter guessed
      correct_letters[i] = letter_guess
  return correct_letters #returns a list

